generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CAPTURADOR
  ANALISTA
}

enum OperationStatus {
  PENDIENTE_OCR
  EN_VALIDACION
  APROBADA
  RECHAZADA
}

enum ValidationRuleKey {
  amount_consistency
  identification_consistency
  merchandise_consistency
  date_consistency
}

enum ValidationSeverity {
  WARN
  ERROR
}

enum ValidationComparator {
  EXACT
  NORMALIZED_TEXT
  NUMERIC
}

enum ValidationDocumentType {
  ALL
  FACTURA
  TRANSPORTE
  IDENTIDAD
  SOLICITUD
  OTRO
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  role         Role
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id])
  createdAt    DateTime    @default(now())
  operations   Operation[]

  @@index([companyId])
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  operations Operation[]
  validationRules ValidationRule[]
  validationFieldRules ValidationFieldRule[]
  aiConfig CompanyAiConfig?
}

model Operation {
  id             String      @id @default(cuid())
  clientName     String
  clientRut      String
  companyId      String?
  company        Company?    @relation(fields: [companyId], references: [id])
  aiSummary      String?
  status         OperationStatus @default(PENDIENTE_OCR)
  requiresReview Boolean     @default(false)
  reviewReason   String?
  validationSummary Json?
  validatedAt     DateTime?
  createdAt      DateTime    @default(now())
  createdById    String
  createdBy      User        @relation(fields: [createdById], references: [id])
  documents      Document[]

  @@index([createdAt])
  @@index([clientName])
  @@index([clientRut])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@index([companyId, status, createdAt])
  @@index([createdById])
  @@index([status])
}

model Document {
  id              String    @id @default(cuid())
  operationId     String
  operation       Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  fileName        String
  mimeType        String
  storageUrl      String
  thumbnailUrl    String
  extractedText   String?
  extractedFields Json?
  hasPii          Boolean   @default(false)
  piiDetections   Json?
  hasSignature    Boolean   @default(false)
  signatureHints  Json?
  confidenceGlobal Float?
  confidenceByField Json?
  createdAt       DateTime  @default(now())
  comments        DocumentComment[]

  @@index([operationId])
  @@index([mimeType])
  @@index([createdAt])
}

model DocumentComment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String
  text       String
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([createdAt])
}

model DocumentReviewFlow {
  id             String   @id @default(cuid())
  documentType   String   @unique
  requiresReview Boolean  @default(false)
  flowName       String?
  checklist      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ValidationRule {
  id           String                 @id @default(cuid())
  companyId    String
  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  ruleKey      ValidationRuleKey
  documentType ValidationDocumentType @default(ALL)
  severity     ValidationSeverity     @default(ERROR)
  isActive     Boolean                @default(true)
  config       Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([companyId, isActive])
  @@index([companyId, documentType, isActive])
}

model ValidationFieldRule {
  id                 String                 @id @default(cuid())
  companyId          String
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  sourceDocumentType ValidationDocumentType @default(ALL)
  targetDocumentType ValidationDocumentType @default(ALL)
  sourceFieldPath    String
  targetFieldPath    String
  comparator         ValidationComparator   @default(NORMALIZED_TEXT)
  severity           ValidationSeverity     @default(ERROR)
  tolerancePct       Float?
  toleranceAbs       Float?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([companyId, isActive])
  @@index([companyId, sourceDocumentType, targetDocumentType, isActive])
}

model CompanyAiConfig {
  id               String   @id @default(cuid())
  companyId        String   @unique
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  extractionProvider String?
  extractionModel  String?
  extractionPrompt String?
  searchProvider   String?
  searchModel      String?
  searchPrompt     String?
  openaiApiKey     String?
  geminiApiKey     String?
  anthropicApiKey  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
}
