# Base de datos PostgreSQL para Vercel (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://user:password@host:5432/db"

# Seguridad sesión
AUTH_SECRET="cambia-esto-por-un-secreto-largo"
# Clave maestra para cifrar secrets en base de datos (recomendado base64 de 32 bytes)
APP_SECRETS_KEY=""

# Usuarios iniciales (seed)
CAPTURADOR_USER="capturador"
CAPTURADOR_PASS="capturador123"
ANALISTA_USER="analista"
ANALISTA_PASS="analista123"

# Proveedor IA por defecto: openai, gemini o anthropic
AI_PROVIDER="openai"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Opcional para almacenar archivos en Vercel Blob
BLOB_READ_WRITE_TOKEN=""
BLOB_ACCESS="private"
